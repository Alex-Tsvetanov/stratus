# Copy to .env and fill in your own values. .env is gitignored.
# Every value here is a PLACEHOLDER. Never commit a real identifier or key.

# Which provider the root Terraform configuration targets: aws | azure
STRATUS_PROVIDER=aws

# Deployment naming and sizing (shared by both providers)
STRATUS_DEPLOYMENT_NAME=stratus-dev
STRATUS_MIN_REPLICAS=1
STRATUS_MAX_REPLICAS=10
STRATUS_IMAGE_TAG=local

# --- AWS -----------------------------------------------------------------
# Authenticate with `aws sso login` or an assumed role. Do not put keys here.
AWS_REGION=<aws-region>
AWS_PROFILE=<local-aws-profile-name>
STRATUS_AWS_BUCKET=<s3-bucket-name>

# --- Azure ---------------------------------------------------------------
# Authenticate with `az login`. Do not put a client secret here.
AZURE_LOCATION=<azure-region>
AZURE_SUBSCRIPTION_ID=<azure-subscription-id>
AZURE_RESOURCE_GROUP=<resource-group-name>
STRATUS_AZURE_CONTAINER=<blob-container-name>

# --- Load generator ------------------------------------------------------
STRATUS_TARGET_URL=<ingress-url-of-the-deployment-under-test>
