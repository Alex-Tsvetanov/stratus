# Copy to .env and fill in your own values. .env is gitignored.
# Every value here is a PLACEHOLDER. Never commit a real identifier or key.

# --- Local stack ---------------------------------------------------------
# Read by the worker and the proxy. The compose file sets them already; these are
# here for running the binaries outside a container.
STRATUS_PORT=8080
STRATUS_THREADS=1
STRATUS_DEFAULT_SIZE=384
STRATUS_DEFAULT_ITER=500
STRATUS_BACKEND_HOST=worker
STRATUS_BACKEND_PORT=8081

# --- Terraform -----------------------------------------------------------
# Which provider the root configuration targets: aws | azure. Pass it as
# -var="target_provider=..." or put it in a .tfvars file, which is gitignored.
STRATUS_TARGET_PROVIDER=aws
STRATUS_DEPLOYMENT_NAME=stratus-dev
STRATUS_IMAGE=<registry>/<repository>:<tag>

# --- AWS -----------------------------------------------------------------
# Authenticate with `aws sso login` or an assumed role. Do not put keys here.
AWS_REGION=<aws-region>
AWS_PROFILE=<local-aws-profile-name>

# --- Azure ---------------------------------------------------------------
# Authenticate with `az login`. Do not put a client secret here.
# ARM_SUBSCRIPTION_ID is read by the azurerm provider from the environment.
AZURE_LOCATION=<azure-region>
ARM_SUBSCRIPTION_ID=<azure-subscription-id>

# --- Load generator ------------------------------------------------------
# Host and port the load generator is pointed at. For a deployed service this is
# the ingress_url output of the root Terraform configuration.
STRATUS_TARGET_HOST=127.0.0.1
STRATUS_TARGET_PORT=8080
